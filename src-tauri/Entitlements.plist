<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Developer ID distribution, not the App Store, so there is deliberately
         no com.apple.security.app-sandbox key here: a sandboxed process cannot
         post CGEvents into other apps (enigo auto-paste) or register global
         shortcuts. Signing turns on the Hardened Runtime, whose microphone key
         is audio-input; the sandbox-only device.microphone and network.client
         keys have no effect outside a sandbox. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
